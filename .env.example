# Copia este archivo como .env (NO lo subas al repositorio) y configura las mismas
# variables en Netlify → Site configuration → Environment variables.

# Cuenta de servicio de Firebase (JSON completo en UNA sola línea). Solo la usan las functions.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Dominio público del sitio, para CORS y enlaces de los correos (sin "/" final).
# Local: http://localhost:8888 · Producción: https://tu-sitio.netlify.app
ALLOWED_ORIGIN=http://localhost:8888

# true en producción cuando App Check (reCAPTCHA v3) esté configurado.
REQUIRE_APP_CHECK=false

# Cloudinary: imágenes de productos y recetas privadas (Dashboard → API Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Pagos reales con Culqi (opcional). Vacío = pago simulado.
# La llave PÚBLICA (pk_test_ / pk_live_) va en src/environments/environment*.ts → culqiPublicKey.
CULQI_SECRET_KEY=

# Correos al cliente (opcional). Ejemplo con Gmail:
# SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=tu-correo@gmail.com,
# SMTP_PASSWORD=<contraseña de aplicación de 16 letras, NO tu contraseña normal>.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Solo para desarrollo con emuladores locales (NO crear en Netlify):
# FIREBASE_PROJECT_ID=demo-farmasalud
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
