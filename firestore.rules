rules_version = '2';

// =============================================================================
// FARMASALUD — Reglas de seguridad de Firestore
// Principio: TODO está denegado salvo lo que se permite explícitamente aquí.
// El rol y la sucursal se leen de los custom claims del token (los asigna solo
// el servidor), así no hace falta un get() extra por cada petición.
// Las operaciones con dinero o stock NO se hacen desde el navegador: las hacen
// las Netlify Functions con Firebase Admin (que no pasa por estas reglas).
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function callerRole() {
      return isSignedIn() ? request.auth.token.get('role', '') : '';
    }

    function callerBranchId() {
      return isSignedIn() ? request.auth.token.get('branchId', '') : '';
    }

    function isAdmin() {
      return callerRole() == 'admin';
    }

    function isWorker() {
      return callerRole() == 'worker';
    }

    function isStaffMember() {
      return isAdmin() || isWorker();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** El trabajador solo opera en su sucursal; el admin en todas. */
    function canOperateInBranch(branchId) {
      return isAdmin() || (isWorker() && callerBranchId() == branchId);
    }

    function changesOnlyFields(allowedFields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }

    // ---------------------------------------------------------------- usuarios
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // El perfil lo crea la function complete-customer-profile / admin-create-staff-user.
      allow create, delete: if false;
      // El cliente solo puede editar sus datos de contacto: nunca role, branchId ni isDisabled.
      allow update: if isOwner(userId)
        && changesOnlyFields(['fullName', 'phone', 'deliveryAddresses', 'updatedAt'])
        && (!('fullName' in request.resource.data) || (request.resource.data.fullName is string && request.resource.data.fullName.size() <= 80))
        && (!('phone' in request.resource.data) || request.resource.data.phone == null || request.resource.data.phone.matches('^9[0-9]{8}$'));
    }

    // ---------------------------------------------------------------- sucursales
    function isShortText(value, minimumLength, maximumLength) {
      return value is string && value.size() >= minimumLength && value.size() <= maximumLength;
    }

    function hasServerTimestamps(data) {
      return data.updatedAt == request.time
        && (resource == null
          ? data.createdAt == request.time
          : data.get('createdAt', null) == resource.data.get('createdAt', null));
    }

    function isValidBranch(data) {
      return data.keys().hasOnly(['name', 'address', 'district', 'phone', 'isActive', 'offersDelivery', 'createdAt', 'updatedAt'])
        && isShortText(data.name, 2, 80)
        && isShortText(data.address, 0, 160)
        && isShortText(data.district, 0, 60)
        && isShortText(data.phone, 0, 20)
        && data.isActive is bool
        && data.offersDelivery is bool
        && hasServerTimestamps(data);
    }

    function isValidCategory(data) {
      return data.keys().hasOnly(['name', 'description', 'isActive', 'createdAt', 'updatedAt'])
        && isShortText(data.name, 2, 60)
        && isShortText(data.description, 0, 200)
        && data.isActive is bool
        && hasServerTimestamps(data);
    }

    // Sin borrado: los pedidos y el personal referencian sucursales y categorías;
    // se desactivan con isActive = false.
    match /branches/{branchId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidBranch(request.resource.data);
      allow delete: if false;
    }

    // ---------------------------------------------------------------- catálogo
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidCategory(request.resource.data);
      allow delete: if false;
    }

    match /products/{productId} {
      // El público solo ve productos activos (las consultas deben filtrar isActive == true).
      allow read: if resource.data.isActive == true || isStaffMember();
      // Se escriben solo con la function admin-save-product (valida, protege el stock y audita precios).
      allow write: if false;

      // Lotes por sucursal: solo personal de esa sucursal los lee. Nadie los escribe
      // desde el navegador: ventas, recepciones y ajustes pasan por las functions.
      match /lots/{lotId} {
        allow read: if isStaffMember() && canOperateInBranch(resource.data.branchId);
        allow write: if false;
      }
    }

    // ---------------------------------------------------------------- inventario
    match /stock_movements/{movementId} {
      allow read: if isStaffMember() && canOperateInBranch(resource.data.branchId);
      allow write: if false;
    }

    // ---------------------------------------------------------------- pedidos
    // El cliente lee solo los suyos (la consulta debe filtrar customerUid == su uid);
    // el personal, los de su sucursal. Crear y cambiar estado: solo functions
    // (create-order, update-order-status), que recalculan precios y mueven stock.
    match /orders/{orderId} {
      allow read: if (isSignedIn() && resource.data.customerUid == request.auth.uid)
        || (isStaffMember() && canOperateInBranch(resource.data.branchId));
      allow write: if false;
    }

    // Reseñas: una por pedido (id = id del pedido), solo del dueño y solo si ya se entregó.
    match /reviews/{orderId} {
      function reviewedOrder() {
        return get(/databases/$(database)/documents/orders/$(orderId)).data;
      }
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.customerUid == request.auth.uid)
        || (isWorker() && callerBranchId() == resource.data.branchId);
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['orderId', 'customerUid', 'branchId', 'rating', 'comment', 'createdAt'])
        && request.resource.data.orderId == orderId
        && request.resource.data.customerUid == request.auth.uid
        && reviewedOrder().customerUid == request.auth.uid
        && reviewedOrder().status == 'delivered'
        && request.resource.data.branchId == reviewedOrder().branchId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && isShortText(request.resource.data.comment, 0, 500)
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------- compras (O01.02)
    function isValidSupplier(data) {
      return data.keys().hasOnly(['name', 'ruc', 'contactName', 'phone', 'email', 'address', 'paymentTerms',
          'deliveryDays', 'isActive', 'createdAt', 'updatedAt'])
        && isShortText(data.name, 2, 120)
        && data.ruc is string && data.ruc.matches('^(10|20)[0-9]{9}$')
        && isShortText(data.contactName, 0, 80)
        && isShortText(data.phone, 0, 20)
        && isShortText(data.email, 0, 120)
        && isShortText(data.address, 0, 160)
        && isShortText(data.paymentTerms, 0, 80)
        && data.deliveryDays is int && data.deliveryDays >= 0 && data.deliveryDays <= 120
        && data.isActive is bool
        && hasServerTimestamps(data);
    }

    match /suppliers/{supplierId} {
      allow read: if isStaffMember();
      allow create, update: if isAdmin() && isValidSupplier(request.resource.data);
      allow delete: if false;
    }

    // Cotizaciones: las arma el admin. Adjudicar (status 'awarded') solo lo hace la
    // function create-purchase-order; una cotización adjudicada ya no se edita.
    match /quotations/{quotationId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['title', 'branchId', 'requestedItems', 'supplierOffers', 'status',
            'awardedSupplierId', 'purchaseOrderId', 'createdAt', 'updatedAt'])
        && isShortText(request.resource.data.title, 3, 120)
        && request.resource.data.status == 'open'
        && request.resource.data.purchaseOrderId == null
        && request.resource.data.requestedItems is list && request.resource.data.requestedItems.size() <= 60
        && request.resource.data.supplierOffers is list && request.resource.data.supplierOffers.size() <= 10
        && hasServerTimestamps(request.resource.data);
      allow update: if isAdmin()
        && resource.data.status == 'open'
        && request.resource.data.status in ['open', 'cancelled']
        && changesOnlyFields(['title', 'requestedItems', 'supplierOffers', 'status', 'updatedAt'])
        && request.resource.data.requestedItems.size() <= 60
        && request.resource.data.supplierOffers.size() <= 10
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Órdenes de compra y recepciones: solo las escriben las functions.
    match /purchase_orders/{purchaseOrderId} {
      allow read: if isStaffMember() && canOperateInBranch(resource.data.branchId);
      allow write: if false;
    }

    match /receptions/{receptionId} {
      allow read: if isStaffMember() && canOperateInBranch(resource.data.branchId);
      allow write: if false;
    }

    // ---------------------------------------------------------------- reclamos
    // Libro de Reclamaciones: número correlativo y respuesta solo desde el servidor.
    match /claims/{claimId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.customerUid == request.auth.uid);
      // Se crean con submit-claim y se responden con respond-claim (envía el correo al cliente).
      allow write: if false;
    }

    // Correlativos (número de pedido, de orden de compra): solo el servidor.
    match /counters/{counterId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------- auditoría
    match /audit_logs/{auditLogId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Contadores internos del limitador de peticiones: solo el servidor.
    match /rate_limits/{rateLimitId} {
      allow read, write: if false;
    }
  }
}
