{
  "name": "farmasalud",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "typecheck:functions": "tsc -p netlify/tsconfig.json --noEmit",
    "emulators": "firebase emulators:start --project demo-farmasalud",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "dev:full": "netlify dev",
    "audit:security": "npm audit --omit=dev --audit-level=high",
    "test:rules": "firebase emulators:exec --only firestore --project demo-farmasalud-rules \"vitest run -c vitest.rules.config.mts\"",
    "emulators:auth": "firebase emulators:start --only auth --project demo-farmasalud",
    "seed:auth": "node scripts/seed-auth-emulator.mjs",
    "test:e2e": "node scripts/e2e-smoke-test.mjs",
    "seed:demo": "node scripts/seed-demo-data.mjs"
  },
  "private": true,
  "packageManager": "npm@12.2.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "bootstrap": "5.3",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "nodemailer": "^10.6.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.30",
    "@angular/cli": "^21.2.30",
    "@angular/compiler-cli": "^21.2.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@netlify/functions": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "firebase-tools": "^14.27.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
